{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "MachineType": {
        "enum": [
          "A",
          "B",
          "C"
        ],
        "title": "MachineType",
        "type": "string"
      },
      "ModelInfoResponse": {
        "additionalProperties": false,
        "properties": {
          "alias": {
            "title": "Alias",
            "type": "string"
          },
          "data_sha256": {
            "title": "Data Sha256",
            "type": "string"
          },
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "quality_gate": {
            "title": "Quality Gate",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "model_name",
          "alias",
          "version",
          "data_sha256",
          "quality_gate",
          "source"
        ],
        "title": "ModelInfoResponse",
        "type": "object"
      },
      "PredictionRequest": {
        "additionalProperties": false,
        "properties": {
          "air_temperature_k": {
            "maximum": 350.0,
            "minimum": 250.0,
            "title": "Air Temperature K",
            "type": "number"
          },
          "machine_type": {
            "$ref": "#/components/schemas/MachineType"
          },
          "process_temperature_k": {
            "maximum": 380.0,
            "minimum": 250.0,
            "title": "Process Temperature K",
            "type": "number"
          },
          "rotational_speed_rpm": {
            "exclusiveMinimum": 0.0,
            "maximum": 5000.0,
            "title": "Rotational Speed Rpm",
            "type": "integer"
          },
          "tool_wear_min": {
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Tool Wear Min",
            "type": "integer"
          },
          "torque_nm": {
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Torque Nm",
            "type": "number"
          }
        },
        "required": [
          "machine_type",
          "air_temperature_k",
          "process_temperature_k",
          "rotational_speed_rpm",
          "torque_nm",
          "tool_wear_min"
        ],
        "title": "PredictionRequest",
        "type": "object"
      },
      "PredictionResponse": {
        "additionalProperties": false,
        "properties": {
          "alias": {
            "title": "Alias",
            "type": "string"
          },
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "prediction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Prediction",
            "type": "integer"
          },
          "probability": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "prediction",
          "probability",
          "model_name",
          "alias",
          "version"
        ],
        "title": "PredictionResponse",
        "type": "object"
      }
    }
  },
  "info": {
